{
  "name": "@tb962/activity-heatmap",
  "version": "0.1.0",
  "description": "Your GitHub contributions and local AI coding activity on one card, collected entirely from your own machine.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "activity-heatmap": "./bin/activity-heatmap.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles.css",
    "bin",
    "lib",
    "README.md",
    "LICENSE",
    "activity.config.example.json",
    "data/activity.example.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --test",
    "pretest": "npm run build",
    "preview": "node scripts/build-preview.mjs"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tb962/activity-heatmap.git"
  },
  "homepage": "https://github.com/tb962/activity-heatmap#readme",
  "bugs": {
    "url": "https://github.com/tb962/activity-heatmap/issues"
  },
  "author": "tb962",
  "keywords": [
    "activity",
    "heatmap",
    "contribution-graph",
    "github",
    "portfolio",
    "react",
    "claude-code",
    "codex",
    "cursor",
    "ai-usage",
    "developer-portfolio"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thilakbhat/heatmap-ui": "^0.1.0"
  }
}
